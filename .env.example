# ========================================================
# BINANCE FUTURES TRADING BOT CONFIGURATION
# ========================================================

# 1. Kredensial API Binance
# Dapatkan API Key dari https://testnet.binancefuture.com (untuk testnet)
# atau https://www.binance.com/en/my/settings/api-management (untuk live trading)
BINANCE_API_KEY=masukkan_api_key_anda_di_sini
BINANCE_API_SECRET=masukkan_api_secret_anda_di_sini

# 2. Mode Jaringan (Sangat disarankan True untuk uji coba tanpa resiko uang sungguhan)
# True = Binance Futures Testnet (Uang demo/palsu)
# False = Binance Futures Live / Production (Uang riil)
USE_TESTNET=true

# 3. Pengaturan Simbol (Multi-Trade) & Timeframe
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,SUIUSDT,NEARUSDT,AVAXUSDT,DOGEUSDT,APTUSDT,RENDERUSDT,1000PEPEUSDT
MAX_ACTIVE_POSITIONS=3
TIMEFRAME=5m

# 4. Pengaturan Futures & Margin
LEVERAGE=10
MARGIN_TYPE=ISOLATED

# 5. Manajemen Risiko (Risk Management)
RISK_PER_TRADE_PERCENT=8.0
FIXED_USDT_PER_TRADE=0

# 6. Take Profit & Stop Loss (dalam persen dari harga entry)
STOP_LOSS_PERCENT=1.0
TAKE_PROFIT_PERCENT=2.0

# 7. Parameter Strategi (EMA Crossover + RSI + Bollinger Bands)
EMA_FAST_PERIOD=9
EMA_SLOW_PERIOD=21
RSI_PERIOD=14
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30
BB_PERIOD=20
BB_STD_DEV=2.0

# 8. Fitur Kuantitatif Institusional: Tiered Trailing Stop (Kunci Profit Bertahap)
ENABLE_TRAILING_STOP=true
TRAILING_TIER1_PROFIT=0.6
TRAILING_TIER1_LOCK=0.05
TRAILING_TIER2_PROFIT=1.2
TRAILING_TIER2_LOCK=0.6
TRAILING_TIER3_PROFIT=1.6
TRAILING_TIER3_LOCK=1.0

ENABLE_BREAK_EVEN=true
BREAK_EVEN_TRIGGER_PERCENT=0.6

# 9. Filter Kekuatan Tren (ADX) & Volume (Anti-Sideways & Anti-Fakeout)
ADX_PERIOD=14
ADX_THRESHOLD=20.0
ENABLE_VOLUME_FILTER=true
VOLUME_SMA_PERIOD=20
VOLUME_FACTOR=0.85

# 10. Multi-Timeframe Filter (1H Trend Confirmation)
USE_MTF_FILTER=true
MTF_TIMEFRAME=1h
MTF_EMA_PERIOD=50

# 11. Fitur Intraday Seasonality (Filter Sesi Jam Dunia & Funding Settlement)
ENABLE_SEASONALITY_FILTER=true
BLOCK_DEAD_ZONE=true
AVOID_FUNDING_SETTLEMENT=true
ASIA_ADX_MINIMUM=22.0

# 12. Loop & Interval Pengecekan (Detik)
POLL_INTERVAL_SECONDS=5

